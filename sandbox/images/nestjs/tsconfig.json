{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "/work",
    "outDir": "/tmp/build",
    "noEmitOnError": false
  },
  "include": ["/work/**/*.ts"],
  "exclude": ["/work/node_modules"]
}
