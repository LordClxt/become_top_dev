# Copier en .env (jamais commité) et remplacer chaque valeur.
# Base PostgreSQL existante (hors de cette pile). sslmode=require si la base l'impose.
DATABASE_URL=postgres://btd:change-me@db.example.com:5432/btd?sslmode=require
SESSION_SECRET=change-me-long-random-string
APP_PASSWORD=change-me
RUNNER_TOKEN=change-me-long-random-string
# En local sans HTTPS : false. Derrière Coolify (HTTPS) : true.
SECURE_COOKIES=true
HTTP_PORT=80
