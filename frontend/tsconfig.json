{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@content/*": [
        "../content/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "remotion": [
        "./node_modules/remotion"
      ],
      "@remotion/player": [
        "./node_modules/@remotion/player"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../content/**/visuals/**/*.tsx"
  ]
}
